# Copy this file to .env and fill it in:   cp .env.example .env
# NEVER commit .env or share it with anyone.

# --- Phone alerts (ntfy) ---
# Install the free ntfy app (iPhone/Android) and subscribe to this topic.
# Anyone who knows the topic name can read your alerts, so make it long and
# random, e.g. gridbot-7f3a9c2e51d84b06. See README "Phone alerts".
NTFY_TOPIC=

# --- Phone commands (ntfy) ---
# A SECOND, different topic the bots read commands from, plus a PIN that every
# command must start with. Leave both empty to turn phone commands off.
# Example message from the ntfy app:  1234 pause kraken
NTFY_COMMAND_TOPIC=
NTFY_COMMAND_PIN=
# The LIVE SOL bot (bot-sollive) reads commands from its OWN private topic,
# so commands meant for the paper bots never reach the real-money bot.
# Same PIN. Long and random, e.g. sollive-3f9a1c7e5b2d8a4f6c0e
NTFY_SOLLIVE_COMMAND_TOPIC=

# --- Email alerts (Gmail) ---
# Your Gmail address, used to SEND the alerts
GMAIL_ADDRESS=you@gmail.com
# A 16-character Gmail "app password" (NOT your normal password). See README step 4.
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Where alerts go. Leave blank to send them to GMAIL_ADDRESS.
ALERT_EMAIL_TO=
# Brevo API key (starts with xkeysib-). Use this if your server provider blocks
# email ports (DigitalOcean does). When set, it is used instead of the app
# password, and GMAIL_ADDRESS must be a verified sender in Brevo. See README.
BREVO_API_KEY=

# --- Kraken API (only needed for live mode) ---
# Permissions: Query Funds, Query Open/Closed Orders & Trades, Create & Modify
# Orders, Cancel/Close Orders. NEVER enable "Withdraw Funds".
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Binance.US API (only needed if the Binance.US bot goes live) ---
# Permissions: Enable Reading and Enable Spot Trading only. NEVER enable
# withdrawals. Restrict the key to your server's IP address.
BINANCEUS_API_KEY=
BINANCEUS_API_SECRET=

# --- Dashboard ---
# Where the dashboard listens. Default 127.0.0.1 = only the server itself.
# Set to the server's Tailscale IP (run: tailscale ip -4) to open it from your
# phone/computer over Tailscale. Never use 0.0.0.0 (that makes it public).
DASHBOARD_BIND=127.0.0.1

# --- Viewing from any computer (Cloudflare) ---
# Optional. Puts the dashboards on your own web address behind a Cloudflare
# Access email login. Leave both empty to keep it off. See README
# "Viewing from any computer".
#   COMPOSE_PROFILES=cloudflare
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=
