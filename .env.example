# Copy this file to .env and fill it in:   cp .env.example .env
# NEVER commit .env or share it with anyone.

# --- Email alerts (Gmail) ---
# Your Gmail address, used to SEND the alerts
GMAIL_ADDRESS=you@gmail.com
# A 16-character Gmail "app password" (NOT your normal password). See README step 4.
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Where alerts go. Leave blank to send them to GMAIL_ADDRESS.
ALERT_EMAIL_TO=

# --- Kraken API (only needed for live mode) ---
# Permissions: Query Funds, Query Open/Closed Orders & Trades, Create & Modify
# Orders, Cancel/Close Orders. NEVER enable "Withdraw Funds".
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
