# Copy this file to .env and fill it in:   cp .env.example .env
# NEVER commit .env or share it with anyone.

# --- Email alerts (Gmail) ---
# Your Gmail address, used to SEND the alerts
GMAIL_ADDRESS=you@gmail.com
# A 16-character Gmail "app password" (NOT your normal password). See README step 4.
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Where alerts go. Leave blank to send them to GMAIL_ADDRESS.
ALERT_EMAIL_TO=
# Brevo API key (starts with xkeysib-). Use this if your server provider blocks
# email ports (DigitalOcean does). When set, it is used instead of the app
# password, and GMAIL_ADDRESS must be a verified sender in Brevo. See README.
BREVO_API_KEY=

# --- Kraken API (only needed for live mode) ---
# Permissions: Query Funds, Query Open/Closed Orders & Trades, Create & Modify
# Orders, Cancel/Close Orders. NEVER enable "Withdraw Funds".
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Dashboard ---
# Where the dashboard listens. Default 127.0.0.1 = only the server itself.
# Set to the server's Tailscale IP (run: tailscale ip -4) to open it from your
# phone/computer over Tailscale. Never use 0.0.0.0 (that makes it public).
DASHBOARD_BIND=127.0.0.1
